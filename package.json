{
  "name": "questkeeper-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run typecheck && npm run build:server && npm run build:web",
    "start": "node dist/server.js",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:server": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "build:web": "npm --prefix web ci && npm --prefix web run build",
    "dev:api": "npm run build:server && node --env-file-if-exists=.env dist/server.js",
    "dev:web": "npm --prefix web run dev"
  },
  "dependencies": {
    "express": "^5.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.0.0",
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "supertest": "^6.3.0",
    "typescript": "^5.8.0",
    "vitest": "^1.0.0"
  }
}
